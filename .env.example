# Copy to .env and fill in. .env is gitignored; never commit real values.
# Manage base URL, ending in /maximo (the public Manage route, not the MAS admin route).
MAXIMO_URL=https://<manage-host>/maximo
MAXIMO_API_KEY=
# Optional. REST base path under MAXIMO_URL (object structures live at <path>/os/<name>).
MAXIMO_API_PATH=api
# Item set used when the loader creates the SRQ organization (inventory lists the existing ones).
MAXIMO_ITEMSETID=
# Optional. Set to false only for a TechZone instance with a self-signed certificate.
MAXIMO_VERIFY_TLS=true
