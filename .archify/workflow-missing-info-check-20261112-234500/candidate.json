  "cards": [
    {
      "dot": "cyan",
      "title": "Where it runs",
      "items": [
        "OpenShift project srq-missinfo on the TechZone cluster, CronJob missinfo-check",
        "Uses the watsonx.ai project AI Service already uses, model gpt-oss-120b",
        "Keys live in an OpenShift secret, never in the code"
      ]
    },
    {
      "dot": "rose",
      "title": "Guardrails",
      "items": [
        "Resident name, phone and email are removed before the text is sent",
        "A gap needs words quoted from the request, or it is dropped",
        "A question with a made-up number is withheld",
        "Notes are internal: nothing is sent and no field changes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Results on the pilot",
      "items": [
        "All 46 open SRs checked in two runs, no errors",
        "Found all 12 expected gaps on open pilot SRs",
        "Flagged 6 of 34 complete SRs for a second look",
        "About 950 tokens per SR"
      ]
    },
    {
      "dot": "amber",
      "title": "Known limits",
      "items": [
        "The county check uses a list of place names, not a map",
        "A typed address without a County address code is flagged",
        "Drafted questions can ask for more than the gaps found"
      ]
    }
  ]
}